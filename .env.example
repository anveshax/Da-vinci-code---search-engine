# ==============================================================================
# ANVESHA AI INTELLIGENCE PLATFORM - ENVIRONMENT CONFIGURATION
# ==============================================================================

# Core Platform Settings
APP_ENV=development
API_PORT=8000
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Primary AI Providers (Configure at least one for live inference)
# 1. Google Gemini (Native REST v1beta)
GEMINI_API_KEY=
GEMINI_DEFAULT_MODEL=gemini-2.5-flash

# 2. Groq (Ultra-fast inference: Llama 3.3, Mixtral)
GROQ_API_KEY=
GROQ_DEFAULT_MODEL=llama-3.3-70b-versatile

# 3. OpenRouter (Multi-model routing: Claude, DeepSeek, GPT-4o)
OPENROUTER_API_KEY=
OPENROUTER_DEFAULT_MODEL=deepseek/deepseek-chat

# 4. OpenAI-Compatible Custom Provider (Ollama, vLLM, LMStudio, LocalAI)
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_BASE_URL=http://localhost:11434/v1
OPENAI_COMPATIBLE_MODEL=llama3

# Metasearch Gateway (SearXNG JSON Microservice)
SEARXNG_URL=http://localhost:8080

# Real Web Search Providers (No Wikipedia fallback)
# Primary: Tavily Search API (https://tavily.com)
TAVILY_API_KEY=

# Secondary / Alternate: Brave Search API (https://brave.com/search/api/)
BRAVE_SEARCH_API_KEY=

# Semantic / Neural: Exa AI Search API (https://exa.ai)
EXA_API_KEY=

# Persistence & Storage
DATABASE_PATH=backend/data/platform.db
WORKSPACE_PATH=/home/amit/codebasec intelligemce engine
