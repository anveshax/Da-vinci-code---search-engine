{
  "id": "anvesha.git-metrics",
  "name": "Git Productivity & Metrics",
  "version": "1.0.0",
  "sdkVersion": "1.0.0",
  "description": "Calculates commit frequency, velocity index, and developer analytics for the Anvesha AI Platform.",
  "author": "Anvesha Core Architecture Team",
  "permissions": [
    "storage:read",
    "storage:write",
    "workspace:read",
    "network:fetch",
    "ui:sidepanel",
    "events:listen",
    "events:emit"
  ],
  "entryPoint": {
    "frontend": "dist/index.js"
  },
  "sidePanel": {
    "title": "Git Productivity",
    "icon": "GitBranch",
    "defaultWidth": 380
  },
  "contributions": {
    "commands": [
      {
        "id": "gitMetrics.refresh",
        "title": "Refresh Git Metrics",
        "category": "Git"
      }
    ]
  }
}
