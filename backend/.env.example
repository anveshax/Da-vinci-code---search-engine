# ==============================================================================
# ANVESHA AI INTELLIGENCE PLATFORM - ENVIRONMENT CONFIGURATION
# ==============================================================================

# Core Platform Settings
APP_ENV=development
API_PORT=8000
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Primary AI Providers (Configure at least one for live inference)
# 1. Google Gemini (Native REST v1beta)
GEMINI_API_KEY=
GEMINI_DEFAULT_MODEL=gemini-2.5-flash

# 2. Groq (Ultra-fast inference: Llama 3.3, Mixtral)
GROQ_API_KEY=
GROQ_DEFAULT_MODEL=llama-3.3-70b-versatile

# 3. OpenRouter (Multi-model routing: Claude, DeepSeek, GPT-4o)
OPENROUTER_API_KEY=
OPENROUTER_DEFAULT_MODEL=deepseek/deepseek-chat

# 4. OpenAI-Compatible Custom Provider (Ollama, vLLM, LMStudio, LocalAI)
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_BASE_URL=http://localhost:11434/v1
OPENAI_COMPATIBLE_MODEL=llama3

# Real Web Search Providers (No Wikipedia fallback)
# Primary: Tavily Search API (https://tavily.com)
TAVILY_API_KEY=

# Secondary / Alternate: Brave Search API (https://brave.com/search/api/)
BRAVE_SEARCH_API_KEY=

# Semantic / Neural: Exa AI Search API (https://exa.ai)
EXA_API_KEY=

# Specialized Intelligence & Scraping Integrations
GITHUB_TOKEN=
OPENALEX_API_KEY=
OPENALEX_MAILTO=
JINA_API_KEY=
FIRECRAWL_API_KEY=
GOOGLE_MAPS_API_KEY=

# Local AI Search & Offline Infrastructure (Ollama)
LOCAL_AI_ENABLED=true
LOCAL_AI_STRICT_MODE=false
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_LLM_MODEL=llama3
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_TIMEOUT=180
OLLAMA_KEEP_ALIVE=5m
EMBEDDING_PROVIDER=gemini
EMBEDDING_DIM=768

# Persistence & Storage
DATABASE_PATH=backend/data/platform.db
WORKSPACE_PATH=/home/amit/codebasec intelligemce engine

# ==============================================================================
# ANVESHA VOICE ENGINE 3.0 CONFIGURATION
# ==============================================================================
VOICE_MODE=pipeline                # Operating mode: pipeline (Mode A) or realtime (Mode B)
DEFAULT_STT_PROVIDER=groq          # Speech-to-Text provider: groq, openai, gemini, or browser
GROQ_STT_MODEL=whisper-large-v3-turbo
OPENAI_STT_MODEL=whisper-1
DEFAULT_TTS_PROVIDER=edge          # Text-to-Speech provider: edge, openai, or browser
OPENAI_TTS_MODEL=tts-1
DEFAULT_VOICE_PERSONA=nova         # nova, atlas, aura, echo, custom
VOICE_SAMPLE_RATE=16000            # Standard 16kHz mono audio
VAD_ENERGY_THRESHOLD=0.015         # Real-time RMS speech detection threshold
VAD_SILENCE_TIMEOUT_MS=800         # Utterance completion silence hangover (ms)
BARGE_IN_ENABLED=true              # Enable immediate speech interruption
VOICE_SESSION_TIMEOUT=1800         # Inactivity timeout in seconds (30m)
AUDIO_RETENTION_HOURS=0            # Audio retention: 0 = zero permanent audio retention (privacy-first)
